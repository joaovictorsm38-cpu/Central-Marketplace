{
  "name": "central-marketplace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @central/api --filter @central/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:validate": "pnpm --filter @central/database prisma:validate",
    "db:generate": "pnpm --filter @central/database prisma:generate",
    "db:migrate": "pnpm --filter @central/database prisma:migrate",
    "db:seed": "pnpm --filter @central/database prisma:seed"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
